# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://compapp_user:CHANGE_ME@localhost:5432/compapp

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# Enables /docs and debug error pages. Keep False in production.
DEBUG=True

# Browser origins allowed by CORS (JSON list). Not needed for native mobile apps.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
