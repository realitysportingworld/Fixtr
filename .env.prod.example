# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it).

# The domain pointing at this server, e.g. compapp.example.com (no https://)
DOMAIN=compapp.example.com

# Database. Use letters and numbers only in the password (it goes into a URL).
# Generate one with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=compapp
POSTGRES_USER=compapp
POSTGRES_PASSWORD=CHANGE_ME

# Signs access tokens. Changing it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# API worker processes (about 2 x CPU cores)
WEB_CONCURRENCY=2

# Password reset emails, through any SMTP provider (Postmark, Amazon SES, Brevo, Mailgun...)
EMAIL_BACKEND=smtp
EMAIL_FROM=CompApp <no-reply@compapp.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
